# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Base de Datos MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/weave_db

# Seguridad y Autenticación JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Almacenamiento de Archivos y Activos
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Almacenamiento en Cloudflare R2 (Opcional - S3 compatible para producción en la nube)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Puente hacia el microservicio FastAPI de IA. La clave de Google vive solo en ia/.env.
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=the_same_secret_configured_in_ia
AI_SERVICE_TIMEOUT_MS=90000

# Compilador LaTeX aislado: construir con docker build -t weave-latex:1 ./latex-compiler
LATEX_DOCKER_IMAGE=weave-latex:1
